{
  "name": "clawfi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "openclaw": {
    "extensions": [
      "./src/openclaw/register.ts"
    ]
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "start:api": "tsx server/index.ts",
    "run:testnet": "tsx server/run-once.ts --mode=real_scaffolded",
    "smoke:testnet": "tsx server/run-once.ts --mode=real_scaffolded",
    "smoke:testnet:live": "tsx server/run-once.ts --mode=real_scaffolded --live=true --auto-approve=false",
    "smoke:testnet:actions": "tsx scripts/live-action-smoke.ts --action=both --trade-usd=1 --defi-usd=1",
    "verify:evidence": "tsx server/validate-evidence.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run --environment jsdom --configLoader runner",
    "test:watch": "vitest --environment jsdom --configLoader runner"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hashgraph/hedera-wallet-connect": "^2.0.7",
    "@hashgraph/sdk": "^2.76.0",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/sign-client": "^2.23.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@eslint/js": "^9.34.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
