VITE_CLAWFI_SCENARIO=demo
VITE_CLAWFI_API_BASE=http://127.0.0.1:8787
VITE_CLAWFI_HEDERA_NETWORK=testnet
VITE_WALLETCONNECT_PROJECT_ID=
VITE_HEDERA_RECEIPT_TOPIC_ID=
VITE_CLAWFI_AGENT_RECIPIENTS_JSON={}

# Browser wallet live connector config
VITE_SAUCERSWAP_ROUTER_CONTRACT_ID=0.0.19264
VITE_SAUCERSWAP_WHBAR_TOKEN_ID=0.0.15058
VITE_SAUCERSWAP_TRADE_GAS=1500000
VITE_SAUCERSWAP_SYMBOL_TOKEN_MAP_JSON={"SAUCE":"0.0.1183558"}
VITE_BONZO_LENDING_POOL_CONTRACT_ID=
VITE_BONZO_LENDING_POOL_EVM_ADDRESS=f67c37ebf347d8fbe31345fd76f3ea6782901f9f
VITE_BONZO_DEFI_ASSET_TOKEN_ID=
VITE_BONZO_DEFI_ASSET_DECIMALS=6
VITE_BONZO_DEFI_ASSET_PRICE_USD=1
VITE_BONZO_DEFI_GAS=1500000

CLAWFI_API_HOST=127.0.0.1
CLAWFI_API_PORT=8787
CLAWFI_SESSION_STORE_PATH=.clawfi/sessions.json
CLAWFI_EVIDENCE_DIR=.clawfi/evidence
HEDERA_MODE=simulated

# These values are for trusted backend/server runtime paths.
HEDERA_NETWORK=testnet
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_OPERATOR_ID=0.0.123456
HEDERA_OPERATOR_EVM_ADDRESS=0x...
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...
HEDERA_OPERATOR_KEY_TYPE=ecdsa
HEDERA_RECEIPT_TOPIC_ID=0.0.654321

# Live execution connector flags (explicit opt-in)
CLAWFI_ENABLE_LIVE_TRADING=false
CLAWFI_ENABLE_LIVE_DEFI=false

# SaucerSwap trading connector (HBAR -> token)
SAUCERSWAP_ROUTER_CONTRACT_ID=0.0.19264
SAUCERSWAP_WHBAR_TOKEN_ID=0.0.15058
SAUCERSWAP_TRADE_GAS=1500000
SAUCERSWAP_SYMBOL_TOKEN_MAP_JSON={"SAUCE":"0.0.1183558"}
SAUCERSWAP_SYMBOL_DECIMALS_JSON={"SAUCE":6,"HBAR":8}

# Bonzo DeFi connector (stable asset deposit)
# Set BONZO_LENDING_POOL_CONTRACT_ID directly, or BONZO_LENDING_POOL_EVM_ADDRESS.
BONZO_LENDING_POOL_CONTRACT_ID=
BONZO_LENDING_POOL_EVM_ADDRESS=f67c37ebf347d8fbe31345fd76f3ea6782901f9f
BONZO_DEFI_ASSET_TOKEN_ID=
BONZO_DEFI_ASSET_DECIMALS=6
BONZO_DEFI_ASSET_PRICE_USD=1
BONZO_DEFI_GAS=1500000
